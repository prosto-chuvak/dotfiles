# Download Znap, if it's not there yet.
[[ -r ~/Repos/znap/znap.zsh ]] ||
    git clone --depth 1 -- \
        https://github.com/marlonrichert/zsh-snap.git ~/Repos/znap
source ~/Repos/znap/znap.zsh  # Start Znap

# Created by newuser for 5.9
export PATH=$PATH:/home/ctas/.local/bin
export PATH="$HOME/bin:$PATH"
export EDITOR=nvim
export PATH=$PATH:/home/ctas/Downloads/zen

# Znap plugins
znap source marlonrichert/zsh-autocomplete
znap source zsh-users/zsh-syntax-highlighting
znap source zsh-users/zsh-autosuggestions

HISTFILE=~/.zsh_history
HISTSIZE=10000                                 
SAVEHIST=10000                                 
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE                       
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt SHARE_HISTORY                           
setopt HIST_VERIFY

eval "$(oh-my-posh init zsh --config ~/.poshthemes/amro.omp.json)"
#eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

alias ls=lsd
alias la="lsd -a"
alias tree="lsd --tree"
alias cat=bat
alias clr=clear
alias gcl="git clone"
alias gc="git commit -m"
alias gs="git status"
alias ga="git add"
alias gch="git checkout"
alias gpo="git push origin"
alias find=fd

#pfetch setting
export PF_INFO="ascii title os wm kernel uptime memory palette"
export PF_SOURCE=""
export PF_CUSTOM_LOGOS="/home/ctas/.config/pfetch/custom_logo"
export PF_ASCII="ctas"
export PF_FAST_PKG_COUNT=1
